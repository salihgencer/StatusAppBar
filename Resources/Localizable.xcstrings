      }
    },
    "kernel_task yükseldi — genelde yoğun disk I/O ya da bellek baskısının belirtisi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kernel_task spiked — usually a sign of heavy disk I/O or memory pressure."
          }
        }
      }
    },
    "kernel_task yükü sıcaklıktan değil bellek sıkıştırmasından geliyor. Çözüm soğutma değil: RAM boşalt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kernel_task load comes from memory compression, not heat. The fix is not cooling: free up RAM."
          }
        }
      }
    },
